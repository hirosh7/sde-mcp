# SD Elements MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Your SD Elements instance URL
SDE_HOST=https://your-sdelements-instance.com

# Your SD Elements API key
# Get this from: Settings > API Tokens in your SD Elements instance
SDE_API_KEY=your-api-key-here

# Anthropic API key (required for streamable HTTP client)
# Get this from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Claude model to use for response formatting (defaults to claude-sonnet-4-5-20250929)
# Available models vary by account/region. Test with: docker compose exec mcp-proxy python3 -c "from anthropic import Anthropic; import os; c=Anthropic(api_key=os.getenv('ANTHROPIC_API_KEY')); print('Testing models...')"
# Options: claude-3-haiku-20240307 (cheaper), claude-sonnet-4-5-20250929 (better quality, recommended)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Optional: Claude model for tool selection (defaults to claude-sonnet-4-5-20250929)
# Using Sonnet 4.5 for better context understanding - critical for session context retention
# Note: Claude 4.5 uses format claude-sonnet-4-5-YYYYMMDD (different from 3.5 format)
# Options: 
#   - claude-3-5-haiku-20241022 (fastest, cheapest, basic context understanding)
#   - claude-3-5-sonnet-20240620 (Claude 3.5 Sonnet - format: claude-{major}-{minor}-{model}-{date})
#   - claude-sonnet-4-5-20250929 (Claude 4.5 Sonnet - recommended for context retention)
#   - claude-3-opus-20240229 (best quality, most expensive)
CLAUDE_TOOL_SELECTION_MODEL=claude-sonnet-4-5-20250929

# Optional: Enable detailed timing information for performance analysis
# Set to "true", "1", or "yes" to enable timing output
# Default: disabled (no timing output)
ENABLE_TIMING=false

# Optional: Log level (defaults to INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Set to DEBUG to see detailed debug messages including conversation history
LOG_LEVEL=INFO

# OpenAI API key (for running integration tests)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Redis Configuration (for session context storage)
# Default: redis://redis:6379 (for Docker Compose)
# For local Redis: redis://localhost:6379
# For external Redis: redis://your-redis-host:6379
REDIS_URL=redis://redis:6379

# Session expiration time in hours (default: 24)
SESSION_TTL_HOURS=24

# Maximum number of conversations per session (default: 50)
SESSION_MAX_CONVERSATIONS=50
