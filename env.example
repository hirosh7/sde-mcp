# SD Elements MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Your SD Elements instance URL
SDE_HOST=https://your-sdelements-instance.com

# Your SD Elements API key
# Get this from: Settings > API Tokens in your SD Elements instance
SDE_API_KEY=your-api-key-here

# Anthropic API key (required for streamable HTTP client)
# Get this from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Claude models. Leave unset to use DEFAULT_CLAUDE_MODEL in mcp-proxy-service/app/config.py.
# Set a model ID only to override the default. Available models vary by account/region.
# CLAUDE_MODEL=
# CLAUDE_TOOL_SELECTION_MODEL=

# Optional: Enable detailed timing information for performance analysis
# Set to "true", "1", or "yes" to enable timing output
# Default: disabled (no timing output)
ENABLE_TIMING=false

# Optional: Log level (defaults to INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Set to DEBUG to see detailed debug messages including conversation history
LOG_LEVEL=INFO

# OpenAI API key (for running integration tests)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Redis Configuration (for session context storage)
# Default: redis://redis:6379 (for Docker Compose)
# For local Redis: redis://localhost:6379
# For external Redis: redis://your-redis-host:6379
REDIS_URL=redis://redis:6379

# Session expiration time in hours (default: 24)
SESSION_TTL_HOURS=24

# Maximum number of conversations per session (default: 50)
SESSION_MAX_CONVERSATIONS=50
