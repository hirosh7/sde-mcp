# MCP Server URL
MCP_SERVER_URL=http://localhost:8001/mcp

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude Model (optional). Leave unset to use DEFAULT_CLAUDE_MODEL in app/config.py.
# CLAUDE_MODEL=

# Enable timing output (optional)
ENABLE_TIMING=false

# Server configuration (optional)
HOST=0.0.0.0
PORT=8002

